+void OAuth2Login::loginAuthorizationCodeWithWebView(const QString &codeVerifier)
+{
+#if defined(USE_WEBENGINE) && !defined(Q_OS_WIN)
+	auto *dialog = new QDialog();
+	dialog->setAttribute(Qt::WA_DeleteOnClose);
+	dialog->resize(960, 720);
+	dialog->setWindowTitle(tr("Pixiv login"));
+
+	auto *layout = new QVBoxLayout(dialog);
+	layout->setContentsMargins(0, 0, 0, 0);
+
+	auto *view = new QWebEngineView(dialog);
+	layout->addWidget(view);
+
+	auto *profile = new QWebEngineProfile(view);
+	profile->setPersistentCookiesPolicy(QWebEngineProfile::NoPersistentCookies);
+	profile->setHttpUserAgent(m_site->userAgent());
+
+	const QUrl redirectUrl = m_site->fixUrl(m_auth->redirectUrl());
+	auto *page = new PixivPkcePage(profile, redirectUrl, view);
+	view->setPage(page);
+
+	const QString codeChallenge = toUrlBase64(QCryptographicHash::hash(codeVerifier.toLatin1(), QCryptographicHash::Sha256));
+	QUrl url = m_site->fixUrl(m_auth->authorizationUrl());
+	QUrlQuery query;
+	query.addQueryItem("code_challenge", codeChallenge);
+	query.addQueryItem("code_challenge_method", "S256");
+	query.addQueryItem("client", "pixiv-android");
+	url.setQuery(query);
+
+	auto done = QSharedPointer<bool>::create(false);
+	connect(dialog, &QDialog::rejected, this, [=]() {
+		if (!*done) {
+			log(QStringLiteral("[%1] OAuth2 PKCE login was cancelled").arg(m_site->url()), Logger::Warning);
+			emit loggedIn(Result::Failure);
+		}
+	});
+
+	page->onRedirect = [=](const QUrl &callbackUrl) {
+		*done = true;
+		const QString code = QUrlQuery(callbackUrl).queryItemValue("code");
+		if (code.isEmpty()) {
+			log(QStringLiteral("[%1] No authorization code received from Pixiv callback").arg(m_site->url()), Logger::Warning);
+			dialog->close();
+			emit loggedIn(Result::Failure);
+			return;
+		}
+
+		QList<QStrP> body { { "grant_type", "authorization_code" }, { "code", code }, { "code_verifier", codeVerifier }, { "include_policy", "true" } };
+		if (!m_auth->redirectUrl().isEmpty()) {
+			body << QStrP("redirect_uri", redirectUrl.toString(QUrl::FullyEncoded));
+		}
+
+		dialog->close();
+		postRequest(body);
+	};
+
+	page->load(url);
+	dialog->show();
+#else
+	Q_UNUSED(codeVerifier)
+#endif
+}
